# Enterprise WeChat Configuration（企业微信应用配置）
CORP_ID=wwXXXXXXXXXXXXXXXX
AGENT_ID=1000002
CORP_SECRET=your-app-secret-here
# 通讯录读取专用 Secret（可选，留空则回退到 CORP_SECRET）
WECOM_CONTACT_SECRET=

# Callback Configuration（回调配置，需与企微后台"接收消息"完全一致）
TOKEN=your-callback-token
ENCODING_AES_KEY=your-43-char-aes-key-here-must-be-exactly-43

# Server（服务器配置）
PORT=80
APP_URL=http://your-domain.com
FRONTEND_URL=http://your-domain.com
# 可选：强制指定登录回调基准域名
AUTH_CALLBACK_BASE_URL=http://your-domain.com

# Auth（登录配置）
# 登录模式：AUTO（默认）| QR（强制扫码）| OAUTH（强制企微内授权）
AUTH_LOGIN_MODE=AUTO
# JWT 签名密钥（强烈建议修改为随机字符串）
JWT_SECRET=change-me-to-a-random-32-char-string

# Permission（权限配置）
# 超级管理员企微 userid（逗号分隔，首次部署必填）
SUPER_ADMIN_USERIDS=your-userid-here
# 全局验收人企微 userid（可选，逗号分隔）
GLOBAL_VERIFIERS=

# Calendar Sync（日历同步配置）
# 默认 OA 日历 ID（留空则自动扫描）
DEFAULT_CAL_ID=
# 员工日历映射（可选）
# 格式1：userid1:cal_id1,userid2:cal_id2
# 格式2：{"userid1":"cal_id1","userid2":"cal_id2"}
USER_CALENDAR_MAP=

# Database（数据库配置）
# 数据库客户端类型：sqlite（默认）| mysql
# 设置为 mysql 时系统使用 MySQL 连接池；未设置且 TASK_BOT_DB_PATH 存在时回退到 SQLite
TASK_BOT_DB_CLIENT=sqlite
# SQLite 自定义路径（可选，默认 backend/database/tasks.db，仅 TASK_BOT_DB_CLIENT=sqlite 时生效）
# TASK_BOT_DB_PATH=./database/tasks.db

# MySQL 配置（仅当 TASK_BOT_DB_CLIENT=mysql 时需要填写）
# 数据库主机地址（默认 127.0.0.1）
# TASK_BOT_DB_HOST=127.0.0.1
# 数据库端口（默认 3306）
# TASK_BOT_DB_PORT=3306
# 数据库用户名（默认 root）
# TASK_BOT_DB_USER=wecom_app
# 数据库密码
# TASK_BOT_DB_PASSWORD=your-db-password
# 数据库名称（默认 wecom_task_bot）
# TASK_BOT_DB_NAME=wecom_task_bot
